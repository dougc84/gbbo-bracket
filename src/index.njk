<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ show.title }}</title>
  <meta name="description" content="Rate each baker's bakes in episodes 1 and 2 and see who's looking strongest.">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧁</text></svg>">
  <link rel="stylesheet" href="assets/css/styles.css">
  <script type="module" src="assets/js/app.js"></script>
</head>
<body>
  <main x-data="tracker" x-cloak>
    <header class="page-head">
      <h1>{{ show.title }}</h1>
    </header>
    <div class="table-scroll">
      <table class="grid">
        <thead>
          <tr class="groups">
            <th rowspan="2" class="sticky contestant-head" scope="col">Contestant</th>
            {% for ep in show.episodes %}
            <th colspan="{{ show.columnsPerEpisode }}" scope="colgroup" class="ep-end">Episode {{ ep }}</th>
            {% endfor %}
          </tr>
          <tr class="cols">
            {% for ep in show.episodes %}
              {% for bake in show.bakes %}
              <th scope="col">{{ bake.label }}</th>
              {% endfor %}
              <th scope="col" class="narrow">In line for <br>Star Baker</th>
              <th scope="col" class="narrow">In line to <br>go home</th>
              <th scope="col" class="narrow">Handshake?</th>
              <th scope="col" class="narrow">Star Baker</th>
              <th scope="col" class="narrow">Went home</th>
              <th scope="col" class="narrow ep-end">Week Score</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          <template x-for="(b, i) in state.bakers" :key="b.id">
            <tr :class="{ 'is-out': b.wentHome !== null }">
              <th scope="row" class="sticky contestant">
                <div class="name-line">
                  <div class="name" contenteditable="plaintext-only" role="textbox" spellcheck="false"
                    :data-placeholder="'Baker ' + (i + 1)" :aria-label="'Name of baker ' + (i + 1)"
                    x-effect="if ($el.innerText !== b.name) $el.textContent = b.name"
                    @input="b.name = $el.innerText.trim() ? $el.innerText.replace(/\n/g, ' ') : ''"
                    @keydown.enter.prevent="$el.blur()"></div>
                  <span class="total-badge" :class="{ neg: total(b) < 0, 'pos-score': total(b) > 0 }" :title="'Total score'" x-text="fmt(total(b))"></span>
                </div>
                <div class="desc" contenteditable="plaintext-only" role="textbox" aria-multiline="true" data-placeholder="Add a description..."
                  :aria-label="'Description of baker ' + (i + 1)"
                  x-effect="if ($el.innerText !== b.description) $el.textContent = b.description"
                  @input="b.description = $el.innerText.trim() ? $el.innerText : ''"></div>
                <button type="button" class="link hide-link" x-show="b.wentHome !== null && expanded[b.id]" @click="expanded[b.id] = false">Hide ratings</button>
              </th>

              <!-- Shown instead of the rating cells once a baker went home. -->
              <td class="gone-cell" colspan="{{ show.episodes.length * show.columnsPerEpisode }}" x-show="collapsed(b)">
                <span>Went home in Episode <span x-text="b.wentHome"></span>. Ratings hidden.</span>
                <button type="button" class="link" @click="expanded[b.id] = true">Show ratings</button>
                <button type="button" class="link" @click="toggleWentHome(b, b.wentHome)">Undo went home</button>
              </td>

              {% for ep in show.episodes %}
                {% for bake in show.bakes %}
                <td class="rating" :class="{ off: !active(b, {{ ep }}) }" x-show="!collapsed(b)">
                  <div class="seg" role="group" aria-label="Episode {{ ep }} {{ bake.label }}">
                    {% for r in show.ratings %}
                    <button type="button" class="opt opt-{{ r.value }}"
                      :aria-pressed="(rating(b, {{ ep }}, '{{ bake.key }}') === '{{ r.value }}').toString()"
                      :disabled="!active(b, {{ ep }})"
                      @click="setRating(b, {{ ep }}, '{{ bake.key }}', '{{ r.value }}')">{{ r.label }}</button>
                    {% endfor %}
                  </div>
                </td>
                {% endfor %}
                <td class="check" :class="{ off: !active(b, {{ ep }}) }" x-show="!collapsed(b)">
                  <input type="checkbox" class="flag-star" :aria-label="'Episode {{ ep }}: in line for Star Baker'"
                    :checked="b.inLineStar[{{ ep }}]" :disabled="!active(b, {{ ep }})"
                    @change="b.inLineStar[{{ ep }}] = $event.target.checked">
                </td>
                <td class="check" :class="{ off: !active(b, {{ ep }}) }" x-show="!collapsed(b)">
                  <input type="checkbox" class="flag-home" :aria-label="'Episode {{ ep }}: in line to go home'"
                    :checked="b.inLineHome[{{ ep }}]" :disabled="!active(b, {{ ep }})"
                    @change="b.inLineHome[{{ ep }}] = $event.target.checked">
                </td>
                <td class="check" :class="{ off: !active(b, {{ ep }}) }" x-show="!collapsed(b)">
                  <input type="checkbox" class="handshake" :aria-label="'Episode {{ ep }}: handshake'"
                    :checked="b.handshake[{{ ep }}]" :disabled="!active(b, {{ ep }})"
                    @change="b.handshake[{{ ep }}] = $event.target.checked">
                </td>
                <td class="check" :class="{ off: !active(b, {{ ep }}) }" x-show="!collapsed(b)">
                  <input type="checkbox" class="star-baker" :aria-label="'Episode {{ ep }}: Star Baker'" x-show="b.wentHome !== {{ ep }}"
                    :checked="isStarBaker(b, {{ ep }})" :disabled="!active(b, {{ ep }})"
                    @change="toggleStarBaker(b, {{ ep }})">
                </td>
                <td class="check" :class="{ off: !active(b, {{ ep }}) }" x-show="!collapsed(b)">
                  <input type="checkbox" class="went-home" :aria-label="'Episode {{ ep }}: went home'" x-show="!isStarBaker(b, {{ ep }})"
                    :checked="b.wentHome === {{ ep }}" :disabled="!active(b, {{ ep }})"
                    @change="toggleWentHome(b, {{ ep }})">
                </td>
                <td class="score ep-end" :class="{ off: !active(b, {{ ep }}) }" x-show="!collapsed(b)" x-text="active(b, {{ ep }}) ? fmt(episodeScore(b, {{ ep }})) : ''"></td>
              {% endfor %}
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <section class="results" aria-labelledby="results-title">
      <h2 id="results-title">Ranking</h2>
      <p class="hint">Strongest at the top, weakest at the bottom.</p>

      <ol class="rank">
        <template x-for="(r, n) in results.ranked" :key="r.id">
          <li>
            <span class="pos" x-text="r.place"></span>
            <span class="who">
              <span class="rname" x-text="r.name"></span>
              <span class="rdetail"><template x-for="(p, k) in summaryParts(r)" :key="k"><span><span x-show="k" class="sep"> · </span><span :class="p.cls" :title="p.title" x-text="p.text"></span></span></template></span>
            </span>
            <span class="rscore" :class="{ neg: r.total < 0, 'pos-score': r.total > 0 }" x-text="fmt(r.total)"></span>
          </li>
        </template>
      </ol>

      <template x-if="results.eliminated.length">
        <div class="gone">
          <h2>Went home</h2>
          <ul>
            <template x-for="r in results.eliminated" :key="r.id">
              <li>
                <span class="rname" x-text="r.name"></span>
                <span class="rdetail" x-text="'Went home in Episode ' + r.wentHome"></span>
              </li>
            </template>
          </ul>
        </div>
      </template>

      <div class="how">
        <h2>How scores work</h2>
        <table class="points">
          <thead>
            <tr><th scope="col">Item</th><th scope="col">Points</th></tr>
          </thead>
          <tbody>
            <template x-for="item in weightItems" :key="item.key">
              <tr>
                <th scope="row" x-text="item.label"></th>
                <td>
                  <input type="number" step="0.25" inputmode="decimal" class="points-input"
                    :aria-label="'Points for ' + item.label"
                    :value="state.weights[item.key]"
                    @input="setWeight(item.key, $event.target.value)"
                    @blur="$event.target.value = state.weights[item.key]">
                </td>
              </tr>
            </template>
          </tbody>
        </table>
        <p class="points-note">Unrated bakes don't count. Changes apply instantly and are saved.
          <button type="button" class="link" x-show="!weightsAreDefault()" @click="resetWeights()">Reset to defaults</button></p>
        <p>Ties: fewer poor bakes ranks higher, then fewer okay bakes. If they're still level, it's a tie and they share a place. Bakers who went home are listed separately.</p>
      </div>
    </section>

    <footer class="page-foot">
      <button type="button" class="link reset" @click="reset()">Clear everything</button>
    </footer>
  </main>
</body>
</html>
